1 VERSIONINFO
 FILEVERSION @RAWENGINE_VERSION_MAJOR@,@RAWENGINE_VERSION_MINOR@,@RAWENGINE_VERSION_PATCH@,0
 PRODUCTVERSION @RAWENGINE_VERSION_MAJOR@,@RAWENGINE_VERSION_MINOR@,@RAWENGINE_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RawEngine"
            VALUE "FileDescription", "RawEngine RAW decoder library"
            VALUE "FileVersion", "@RAWENGINE_VERSION@"
            VALUE "InternalName", "therapee"
            VALUE "LegalCopyright", "Copyright (C) RawTherapee Development Team"
            VALUE "OriginalFilename", "therapee.dll"
            VALUE "ProductName", "RawEngine"
            VALUE "ProductVersion", "@RAWENGINE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
